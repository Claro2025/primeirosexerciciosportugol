programa {
  funcao inicio() {
   inteiro laranjas, lrj_vendidas, calculo
    cadeia vendas
       
        // receber valor para esta daods
    //escreva("valor do vouch: ")
    //leia(vouch)
    escreva("Digite a quantidade de laranjas: ")
    leia(laranjas)
    escreva("Digite a quantidade de laranjas vendidas: ")
    leia(lrj_vendidas)
    // processamento / calcualo
    calculo = laranjas - lrj_vendidas
    // apresentação dos resultados - saída
    //escreva("Seu time tem " + pontos + "pontos")
    escreva("laranjas vendidas: "+ calculo)

  }
}