programa {
  funcao inicio() {

    inteiro pares, valor, soma
    cadeia valetroca
       
        // receber valor para esta daods
    //escreva("valor do vouch: ")
    //leia(vouch)
    escreva("Digite a quantidade de pares: ")
    leia(pares)
    escreva("Digite o valor: R$  ")
    leia(valor)
    // processamento / calculo
    soma = pares * valor
    // apresentação dos resultados - saída
    //escreva("Seu time tem " + pontos + "pontos")
    escreva("vale troca: R$ "+ soma)
    
    
  }
}
